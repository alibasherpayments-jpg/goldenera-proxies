# ════════════════════════════════════════════════════
#  GoldenEra 5G Proxies — Environment Configuration
# ════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_IDS=123456789,987654321      # comma-separated admin Telegram IDs

# ── Magnum Reseller API ───────────────────────────
MAGNUM_API_KEY=your_magnum_api_key_here
MAGNUM_BASE_URL=https://api.magnumproxy.com

# ── Database ──────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./goldenera.db
# For PostgreSQL (Neon / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# ── Admin Dashboard ───────────────────────────────
DASHBOARD_SECRET_KEY=change_this_to_a_random_64_char_string
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password

# ── Binance Payment ───────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_WALLET_ADDRESS=your_usdt_trc20_wallet
BINANCE_MERCHANT_ID=your_binance_pay_merchant_id

# ── Vodafone Cash ─────────────────────────────────
VODAFONE_CASH_NUMBER=01XXXXXXXXX         # رقم فودافون كاش لاستقبال التحويلات

# ── Currency ──────────────────────────────────────
USD_TO_EGP_RATE=52.00                   # سعر الصرف الافتراضي (يمكن تعديله من لوحة التحكم)

# ── App Settings ─────────────────────────────────
ENVIRONMENT=development                  # development | production
PORT=8000
WEBHOOK_BASE_URL=https://your-app.onrender.com   # للإنتاج فقط

# ── Pricing Markup ────────────────────────────────
DEFAULT_MARKUP_PERCENT=30               # نسبة الربح الافتراضية على أسعار Magnum
